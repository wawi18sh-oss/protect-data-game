<!doctype html>
<html lang="ar">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>احمِ بياناتك — جامعة الطائف</title>
  <style>
    body {
      font-family: "Tajawal", sans-serif;
      direction: rtl;
      text-align: center;
      background: #F0F4FA;
      color: #0B2340;
      padding: 20px;
    }
    .container {
      max-width: 800px;
      margin: 0 auto;
    }
    .header {
      margin-bottom: 30px;
    }
    .header img {
      max-width: 200px;
      margin-bottom: 10px;
    }
    .card {
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 8px 24px rgba(2,15,60,0.08);
      padding: 30px;
      margin-bottom: 30px;
    }
    h1 {
      margin: 0 0 10px;
      color: #072047;
    }
    button {
      padding: 14px 22px;
      border-radius: 8px;
      border: none;
      background: #0B5ED7;
      color: #fff;
      font-weight: 600;
      cursor: pointer;
      font-size: 16px;
    }
    button:disabled {
      background: #A5C5F8;
      cursor: not-allowed;
    }
    .option {
      display: block;
      margin: 14px 0;
      text-align: right;
    }
    .option button {
      width: 100%;
    }
    .hidden {
      display: none;
    }
    #feedback {
      margin-top: 16px;
      font-size: 15px;
      text-align: right;
    }
    #result {
      text-align: center;
    }
    .score {
      font-size: 20px;
      margin-top: 12px;
    }
    .badge {
      display: inline-block;
      padding: 8px 14px;
      border-radius: 20px;
      background: #E6F0FF;
      color: #0B5ED7;
      margin: 6px;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <img src="https://upload.wikimedia.org/wikipedia/ar/9/98/%D8%B4%D8%B9%D8%A7%D8%B1_%D8%AC%D8%A7%D9%85%D8%B9%D8%A9_%D8%A7%D9%84%D8%B7%D8%A7%D8%A6%D9%81_%D8%A7%D9%84%D8%B3%D8%B9%D9%88%D8%AF%D9%8A%D8%A9.png" alt="شعار جامعة الطائف">
      <h1>احمِ بياناتك</h1>
      <p>لعبة تفاعلية سريعة مقدّمة من كلية علوم الحاسب – جامعة الطائف</p>
    </div>
    <div class="card" id="game">
      <div id="qbox"></div>
      <div id="opts"></div>
      <div id="feedback" class="hidden"></div>
      <div style="margin-top:20px;">
        <button id="nextBtn" class="hidden">التالي</button>
      </div>
      <div id="result" class="hidden card" style="margin-top:30px"></div>
    </div>
    <div>
      <button id="startBtn">ابدأ اللعب</button>
      <button id="restartBtn" class="hidden" style="background:#6C757D; margin-left:10px;">إعادة</button>
    </div>
    <div style="margin-top:14px">
      <span class="badge">مدة اللعبة: ~3 دقائق</span>
      <span class="badge">عدد الأسئلة: 6</span>
    </div>
  </div>

<script>
const questions = [
  {
    q: "وصلك رابط في بريد الجامعة من شخص مجهول يطلب تحديث بياناتك. أول خطوة؟",
    opts: ["أضغط الرابط بسرعة لأني مشغول","أتجاهل الرابط بالكامل","أتأكد من مرسل الرسالة عبر البريد الرسمي أو أتواصل مع الدعم","أعيد توجيهه لأصدقائي"],
    correct: 2,
    explain: "تحقّق من مرسل الرسالة أولًا ولا تضغط روابط مشكوك فيها. التواصل مع الدعم الرسمي آمن."
  },
  {
    q: "عند إنشاء كلمة مرور لحساب الجامعة، أي الخيار أفضل؟",
    opts: ["12345678","اسمك وتاريخ ميلادك","عبارة طويلة من كلمات و رموز مختلفة","كلمة واحدة قصيرة سهلة التذكر"],
    correct: 2,
    explain: "استخدم عبارة مرور طويلة ومعقّدة أو مدير كلمات مرور."
  },
  {
    q: "صديق يطلب منك مشاركة ملفات المشروع على Google Drive ويعطي صلاحية 'تحرير' لعموم الرابط. ماذا تفعل؟",
    opts: ["أقبل مباشرة لأن هو صديق","أشارك الرابط ولكن بصلاحية 'عرض' فقط","أرفع الملف على حساب شخصي وأعطي كل الناس الرابط","لا أشارك أي شيء أبدًا"],
    correct: 1,
    explain: "شارك بصلاحيات محدودة (عرض) وفضّل مشاركة على مجموعات محمية أو عبر النظام الجامعي."
  },
  {
    q: "وجدت برنامج مجاني 'مفيد' ضمن ملف مضغوط من مصدر غير معروف — تريد تثبيته للشرح العملي. ماذا تفعل؟",
    opts: ["أثبّته فورًا لأن مفيد","أمسحه لأن دايمًا برامج مجانية سيئة","أفحص الملف بمضاد فيروسات وآخذ نسخة احتياطية قبل التثبيت","أشارك الملف مع زملائك بدون فحص"],
    correct: 2,
    explain: "افحص الملفات دائمًا قبل التثبيت وخذ نسخة احتياطيّة."
  },
  {
    q: "فتح قاعة المحاضرة على Zoom، تريد تسجيل الطلاب لاستخدام داخلي. ما الأفضل؟",
    opts: ["أسجّل بدون إعلام لأن هذا أسرع","أطلب موافقة الحضور قبل التسجيل وأخزن التسجيل في مكان آمن","أشارك التسجيل مع أي شخص","أرفع التسجيل على منصّات عامة بدون قيود"],
    correct: 1,
    explain: "الحصول على موافقة والحفاظ على سرّية التسجيل والتخزين الآمن مهمّ."
  },
  {
    q: "ما أفضل ممارسة لإدارة حساباتك الجامعية؟",
    opts: ["نفس كلمة المرور لكل شيء","مشاركة كلمة المرور مع زميل مسؤول فقط","تفعيل المصادقة الثنائية وتحديث كلمات المرور دوريًا","الاعتماد على تذكّرها فقط دون مدير كلمات مرور"],
    correct: 2,
    explain: "تفعيل التحقّق الثنائي واستخدام مدير كلمات يُحسّن الأمان كثيرًا."
  }
];

let idx=0, score=0;
const qbox=document.getElementById('qbox'),
      optsDiv=document.getElementById('opts'),
      feedback=document.getElementById('feedback'),
      startBtn=document.getElementById('startBtn'),
      nextBtn=document.getElementById('nextBtn'),
      result=document.getElementById('result'),
      restartBtn=document.getElementById('restartBtn');

function showQuestion(i){
  const item=questions[i];
  qbox.innerHTML = `<h3>سؤال ${i+1}: ${item.q}</h3>`;
  optsDiv.innerHTML = '';
  item.opts.forEach((op,j)=>{
    const btn = document.createElement('button');
    btn.innerText = op;
    btn.className='optionBtn';
    btn.style.marginTop='8px';
    btn.onclick = () => selectOption(j);
    const wrapper = document.createElement('div'); wrapper.className='option';
    wrapper.appendChild(btn);
    optsDiv.appendChild(wrapper);
  });
  feedback.classList.add('hidden');
  nextBtn.classList.add('hidden');
}

function selectOption(chosen){
  const item=questions[idx];
  const buttons = document.querySelectorAll('.optionBtn');
  buttons.forEach(b=>b.disabled=true);
  if(chosen === item.correct){
    score++;
    feedback.innerHTML = `<div style="color:green;font-weight:700">إجابة صحيحة ✅</div><div style="margin-top:6px">${item.explain}</div>`;
  } else {
    feedback.innerHTML = `<div style="color:#b00;font-weight:700">خطأ ❌</div><div style="margin-top:6px">${item.explain}</div>`;
  }
  feedback.classList.remove('hidden');
  nextBtn.classList.remove('hidden');
}

nextBtn.onclick = () => {
  idx++;
  if(idx < questions.length){
    showQuestion(idx);
  } else {
    finishGame();
  }
};

function finishGame(){
  document.getElementById('game').classList.add('hidden');
  result.classList.remove('hidden');
  const percent = Math.round((score/questions.length)*100);
  let medal = '📘';
  if(percent >= 85) medal='🏆';
  else if(percent >= 60) medal='🎖️';
  else if(percent >= 40) medal='🔰';
  result.innerHTML = `
    <h2>انتهت اللعبة ${medal}</h2>
    <p class="score">درجتك: ${score} من ${questions.length} — (${percent}%)</p>
    <p>نقاط لتحسين الحماية الرقمية:</p>
    <ul style="text-align:right;display:inline-block;margin-top:8px">
      <li>فعّل المصادقة الثنائية</li>
      <li>استخدم مدير كلمات مرور</li>
      <li>تحقّق قبل الضغط على أي رابط</li>
      <li>احترس عند مشاركة صلاحيات التحرير</li>
    </ul>
    <div style="margin-top:14px"><button onclick="location.reload()">العب مرة أخرى</button></div>
  `;
  restartBtn.classList.remove('hidden');
}

startBtn.onclick = () => {
  startBtn.classList.add('hidden');
  showQuestion(0);
  idx=0;
  score=0;
};

restartBtn.onclick = () => location.reload();
</script>
</body>
</html>
